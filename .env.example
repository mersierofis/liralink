# LiraLink backend environment. Copy to .env and fill in; .env is git-ignored.
# This file is PUBLIC: every value here is empty. Examples and defaults are in the comments only.
# One name per variable. The code must read SOROBAN_RPC_URL (never RPC_URL) and
# PLATFORM_ACCOUNT_SECRET / INVOICE_CONTRACT_ID (no aliases).

# --- Runtime ---
# development | test | production
NODE_ENV=
# HTTP port of the API, e.g. 3000
PORT=
# Comma-separated browser origins allowed by CORS (merchant-web and pay-web), e.g. http://localhost:5173,http://localhost:5174
CORS_ORIGINS=
# Base URL the API prefixes to a link code to build payUrl, e.g. http://localhost:5174/p
PAY_WEB_BASE_URL=

# --- Database ---
# PostgreSQL connection string, e.g. postgresql://<user>:<pass>@localhost:5432/liralink
DATABASE_URL=

# --- Auth ---
# HMAC secret that signs merchant JWTs; long and random, never reused across environments
JWT_SECRET=

# --- Stellar network ---
# testnet | public (the SEP-6 TRY anchor and x402 rail are testnet-only)
STELLAR_NETWORK=
# Horizon base URL, e.g. https://horizon-testnet.stellar.org
HORIZON_URL=
# Soroban RPC URL for contract calls and getEvents, e.g. https://soroban-testnet.stellar.org
SOROBAN_RPC_URL=
# Network passphrase, e.g. "Test SDF Network ; September 2015"
NETWORK_PASSPHRASE=

# --- Assets ---
# Asset code of the settlement stablecoin, e.g. USDC
USDC_CODE=
# Issuer (G...) of that asset; Circle testnet USDC is documented in docs/00-PROJECT.md
USDC_ISSUER=

# --- Platform account ---
# Secret seed (S...) of the custodial collection account; signs payouts, invoices and SEP-10. Server .env only.
PLATFORM_ACCOUNT_SECRET=

# --- Soroban invoice contract ---
# Contract ID (C...) of the invoice contract; empty disables the contract rail
INVOICE_CONTRACT_ID=

# --- FX ---
# mock | live | anchor (anchor = SEP-38 price from ANCHOR_HOME_DOMAIN, falls back to mock)
FX_PROVIDER=
# Fixed TRY-per-USDC rate for FX_PROVIDER=mock and as the fallback, e.g. 34.00
FX_MOCK_RATE_TRY_PER_USDC=
# Optional public rate endpoint for FX_PROVIDER=live
FX_LIVE_URL=

# --- Anchor ---
# mock | sep6 | sep24 (sep6 = the TRY rail; mock = in-process, instant)
ANCHOR_PROVIDER=
# Anchor home domain without scheme, e.g. tr-mock-anchor.fly.dev (sep6) or testanchor.stellar.org (sep24)
ANCHOR_HOME_DOMAIN=
# sep24 on testanchor only: reference-server URL the backend posts the KYC form to; empty for real anchors
ANCHOR_SEP24_TEST_KYC_URL=
# sep24 only: withdraw body encoding, multipart | urlencoded (never JSON)
ANCHOR_SEP24_ENCODING=
# mock only: simulated anchor latency in ms, e.g. 3000
ANCHOR_MOCK_DELAY_MS=

# --- Payment links ---
# Default link lifetime in hours, e.g. 24
LINK_DEFAULT_EXPIRY_HOURS=
# Lifetime of an off-chain link's quote in minutes before /pay re-quotes, e.g. 10
QUOTE_TTL_MINUTES=

# --- x402 agent rail ---
# x402 facilitator URL, e.g. https://x402.org/facilitator (testnet only); empty disables the route
X402_FACILITATOR_URL=

# --- Scripts only (seed / demo / agent) ---
# Password the seed script sets for the demo merchant (DEMO_PASSWORD in the docs); server .env only
SEED_DEMO_PASSWORD=
# Public key (G...) of the payer wallet used by demo scripts
DEMO_PAYER_ADDRESS=
# Secret seed (S...) of the test agent wallet used by the x402 demo client; local only
AGENT_SECRET=

# --- Opt-in live e2e tests (leave empty; set to 1 to spend real testnet USDC) ---
# Run the live SEP-6 settlement e2e
SEP6_E2E=
# Run the live SEP-24 settlement e2e
SEP24_E2E=
# Run the manual-KYC SEP-24 e2e (needs a person with a browser)
SEP24_MANUAL_KYC=
# File the manual-KYC e2e writes the interactive URL to
SEP24_URL_FILE=
# Run the live USDC-withdrawal e2e
USDC_WD_E2E=
# Destination G... account for the live USDC-withdrawal e2e
USDC_WD_E2E_DESTINATION=
